# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Secrets / local config ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime data / generated output (not source) ────────────────────────
*.db
*.sqlite3
uploads/*
!uploads/.gitkeep
data/reports/*
!data/reports/.gitkeep
reports/*
!reports/.gitkeep

# ── Test artifacts generated at run time ────────────────────────────────
tests/*.db

# ── OS / editor ──────────────────────────────────────────────────────────
.DS_Store
*.swp
.vscode/
.idea/
