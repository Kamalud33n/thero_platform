# Copy this file to .env and fill in real values. Never commit the real .env.

# ── Database ────────────────────────────────────────────────────────────
# For docker-compose (service name "db"):
DATABASE_URL=mysql+pymysql://thero:thero@db:3306/rehab_db_v2?charset=utf8mb4
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=rehab_db_v2
MYSQL_USER=thero
MYSQL_PASSWORD=thero

# true only when the server itself has a physical camera attached.
# On a cloud deployment there is no camera on the box — keep this false.
LOCAL_CAMERA_ENABLED=false

# ── MedNova Care SSO bridge (auth.py) ─────────────────────────────────
# Algorithm Laravel signs the therapist bridge JWT with: HS256 or RS256
MEDNOVA_JWT_ALGORITHM=RS256

# HS256 secret — only used if MEDNOVA_JWT_ALGORITHM=HS256
# MEDNOVA_JWT_SECRET=

# Required for RS256 — Laravel's public key (PEM), single line with \n
# escapes or a triple-quoted block depending on how you load it.
MEDNOVA_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Expected iss/aud claims on the bridge JWT. Leave unset to skip validation.
MEDNOVA_JWT_ISSUER=
MEDNOVA_JWT_AUDIENCE=

# Separate shared secret for the Laravel -> thero patient-sync webhook.
MEDNOVA_WEBHOOK_SECRET=change-this-to-the-real-webhook-secret

# Comma-separated list of MedNova Care frontend origin(s) allowed to call
# this API (CORS).
MEDNOVA_ALLOWED_ORIGINS=https://mednovacare.com,https://www.mednovacare.com

# Secret used to sign single-use patient session tokens.
PATIENT_SESSION_TOKEN_SECRET=change-me-to-a-long-random-string

# ── Telehealth TURN server (optional, telehealth.py) ──────────────────
# METERED_TURN_URL=
# METERED_TURN_USERNAME=
# METERED_TURN_CREDENTIAL=

# ── Session-scheduled webhook (thero -> Laravel, telehealth.create_room) ──
# MEDNOVA_SCHEDULE_WEBHOOK_URL=
# MEDNOVA_SCHEDULE_WEBHOOK_SECRET=

# Public base URL of this thero deployment (no trailing slash), e.g.
# https://thero.mednovacare.com
THERO_PUBLIC_BASE_URL=

# ── Time / timezone ─────────────────────────────────────────────────────
# Everything internal (DB, tokens, WS timestamps, /api/health) runs on
# UTC — see services/timeutils.py. This is ONLY used to localize
# server-rendered PDF reports for a human reader (browser-facing
# timestamps localize automatically via the viewer's own device).
# Not auto-detected from the network/server IP on purpose — see
# services/timeutils.py's docstring for why.
DISPLAY_TIMEZONE=Asia/Muscat

# ── Demo data ───────────────────────────────────────────────────────────
# Set true to seed 3 sample patients + demo sessions on a fresh DB.
SEED_DEMO_DATA=false
