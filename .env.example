# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:changeme@localhost:3306/rehab_db_v2?charset=utf8mb4

# true only when the server itself has a physical camera attached
LOCAL_CAMERA_ENABLED=true

# ── MedNova Care SSO bridge (auth.py) ─────────────────────────────────
# Algorithm Laravel signs the therapist bridge JWT with: HS256 or RS256
MEDNOVA_JWT_ALGORITHM=RS256

# HS256 secret — no longer used now that we're on RS256, left commented
# out rather than deleted in case we ever need to roll back.
# MEDNOVA_JWT_SECRET=replace-with-your-own-secret

# Required for RS256 — Laravel's public key (PEM). This is the public half
# of the pair Nada generated; the private key stays on MedNova Care's
# server and is never shared.
MEDNOVA_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
<paste the staging public key PEM here>
-----END PUBLIC KEY-----"

# Expected iss/aud claims on the bridge JWT — Nada said she'd send these
# along with the staging domain. Leave unset (validation is skipped) until
# she confirms, then uncomment and fill in.
MEDNOVA_JWT_ISSUER=mednovacare-staging
MEDNOVA_JWT_AUDIENCE=thero-bridge

# Separate shared secret for the Laravel -> thero patient-sync webhook
# (routers/integration.py), NOT the therapist JWT.
# NOTE: per the architecture discussion, the patient-sync webhook is being
# dropped in favour of the patient-scoped session token system — once
# routers/integration.py's webhook route is actually removed, delete this
# too. Leaving it set for now so nothing breaks if the route is still live.
MEDNOVA_WEBHOOK_SECRET=change-this-to-the-real-webhook-secret

# Comma-separated list of the MedNova Care frontend origin(s) allowed to
# call this API (CORS). Confirmed by Nada — staging domain still pending,
# add it here (comma-separated) once she sends it.
MEDNOVA_ALLOWED_ORIGINS=https://mednovacare.com,https://www.mednovacare.com,http://localhost:3000,http://127.0.0.1:8000

# ── Telehealth TURN server (optional, telehealth.py) ──────────────────
# METERED_TURN_URL=
# METERED_TURN_USERNAME=
# METERED_TURN_CREDENTIAL=

# ── Demo data ───────────────────────────────────────────────────────────
# Set true to seed 3 sample patients + demo sessions on a fresh DB
SEED_DEMO_DATA=true
MEDNOVA_JWT_SECRET=replace-with-your-own-secret

PATIENT_SESSION_TOKEN_SECRET=replace-with-a-long-random-secret

# ── Session-scheduled webhook (thero -> Laravel, telehealth.create_room) ──
# Separate direction/secret from the results webhook — fires for both
# Remote and Self Training rooms so Laravel can route the patient to
# their join_url. Laravel's receiving endpoint isn't built yet — leave
# unset until they send the real URL + secret (webhook is a no-op/log-
# and-skip with these unset, nothing breaks).
# MEDNOVA_SCHEDULE_WEBHOOK_URL=
# MEDNOVA_SCHEDULE_WEBHOOK_SECRET=

# Public base URL of this thero deployment (no trailing slash) — needed
# to turn the relative join_url into an absolute link before it's sent
# to Laravel above, since Laravel is on a different domain and a
# relative path means nothing to them. e.g. https://thero.mednovacare.com
# THERO_PUBLIC_BASE_URL=